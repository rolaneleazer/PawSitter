# ==============================================================================
# PawShield - Vercel (Free Tier) + Supabase (Free Tier) Environment Variables
# Copy these into Vercel Project Settings -> Environment Variables
# ==============================================================================

# 1. REQUIRED: Supabase PostgreSQL Connection Pooler URI
# IMPORTANT FOR VERCEL FREE TIER:
# Use the Supabase "Transaction Pooler" URI (port 6543, host *.pooler.supabase.com)
# or "Session Pooler" URI (port 5432, host *.pooler.supabase.com).
# Do NOT use the Direct Connection (db.*.supabase.co) because it is IPv6-only
# and will fail to connect from Vercel IPv4 Serverless Functions.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# 2. REQUIRED: Session Signing Secret (generate a random 32+ char string)
JWT_SECRET=change_this_to_a_long_random_secret_string

# 3. OPTIONAL: Canonical App URL (auto-detected on Vercel if omitted)
APP_URL=https://your-app.vercel.app

# 4. OPTIONAL: Google Gemini AI API Key (powers AI Bug Inspector, UX, SEO & QA Agents)
GEMINI_API_KEY=

# 5. OPTIONAL: Google AdSense Client ID
VITE_GOOGLE_ADSENSE_CLIENT_ID=

# 6. OPTIONAL: Stripe Escrow Payments (leave blank for Cash-on-Service mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# 7. OPTIONAL: Firebase Project ID (defaults to firebase-applet-config.json)
FIREBASE_PROJECT_ID=
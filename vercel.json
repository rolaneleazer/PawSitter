{
  "version": 2,
  "buildCommand": "vite build && npm run build:api",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__vpath=/api/$1"
    },
    {
      "source": "/ads.txt",
      "destination": "/api/index.js?__vpath=/ads.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.js?__vpath=/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.js?__vpath=/sitemap.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/index.js?__vpath=/llms.txt"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/index.js?__vpath=/llms-full.txt"
    },
    {
      "source": "/.well-known/llms.txt",
      "destination": "/api/index.js?__vpath=/.well-known/llms.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
